# LLM provider: openai, openrouter, or groq
LLM_PROVIDER=groq

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://...

# OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_SITE_URL=https://your-site.example
# OPENROUTER_APP_NAME=ResRAG

# Groq (OpenAI-compatible API)
GROQ_API_KEY=
# Fast Groq default when omitted: openai/gpt-oss-20b
GROQ_MODEL=

# Optional generic model override
# LLM_MODEL=

# Retrieval models
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# High-recall retrieval settings
RERANK_MODE=auto
RETRIEVAL_DENSE_K=32
RETRIEVAL_SPARSE_K=32
RETRIEVAL_FINAL_K=8
RERANK_CANDIDATE_K=24
MAX_OUTPUT_TOKENS=256
SHOW_LATENCY=1

# Progressive ingestion
# Uploads first get a lightweight BM25/text index; the full semantic/table-aware
# index is built in a background worker and replaces it automatically.
FAST_FULL_TEXT_WORDS=5000
LONG_DOCUMENT_PAGES=80

# Optional: use Sentence Transformers ONNX backend after installing its ONNX extra
# EMBEDDING_BACKEND=onnx

# Optional scanned-PDF fallback (requires Tesseract installed on the machine)
# OCR_ENABLED=1

# LLM provider: openai, openrouter, or groq
LLM_PROVIDER=groq

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional OpenAI-compatible endpoint override
# OPENAI_BASE_URL=https://...

# OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional attribution headers
# OPENROUTER_SITE_URL=https://your-site.example
# OPENROUTER_APP_NAME=ResRAG

# Groq (OpenAI-compatible API)
GROQ_API_KEY=
# Current fast Groq default if this is omitted: openai/gpt-oss-20b
GROQ_MODEL=

# Optional generic model override when the provider-specific model is omitted
# LLM_MODEL=

# Retrieval models
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Latency-oriented retrieval settings
# auto skips the cross-encoder when BM25 and dense retrieval agree on the winner
RERANK_MODE=auto
RETRIEVAL_DENSE_K=12
RETRIEVAL_SPARSE_K=12
RETRIEVAL_FINAL_K=4
RERANK_CANDIDATE_K=8
MAX_OUTPUT_TOKENS=192
# Set to 1 while tuning; adds retrieval/LLM/total timings to the UI
SHOW_LATENCY=1

# Optional: use Sentence Transformers ONNX backend after installing its ONNX extra
# EMBEDDING_BACKEND=onnx

# Optional scanned-PDF fallback (requires Tesseract installed on the machine)
# OCR_ENABLED=1
